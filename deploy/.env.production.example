# Copie este arquivo para deploy/.env.production somente na VM Oracle.
# Nunca envie deploy/.env.production ao GitHub.

# PostgreSQL interno do Docker. Gere uma senha segura, sem @, :, /, % ou #.
POSTGRES_DB=rsi_radar
POSTGRES_USER=rsi_radar
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_HEX_ALEATORIA
DATABASE_URL=postgresql+psycopg://rsi_radar:SUBSTITUA_POR_UMA_SENHA_HEX_ALEATORIA@db:5432/rsi_radar

# API / worker
FLASK_DEBUG=false
LOG_LEVEL=INFO
APP_TIMEZONE=America/Sao_Paulo
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=60

# HTTPS. Use um domínio seu ou um subdomínio gratuito, por exemplo DuckDNS.
CADDY_DOMAIN=api-seu-rsi.duckdns.org
CADDY_EMAIL=seu-email@exemplo.com

# Enquanto o painel morar na API, use a URL HTTPS da própria API.
# Quando o frontend independente estiver no Render, substitua pela URL do painel.
DASHBOARD_PUBLIC_URL=https://api-seu-rsi.duckdns.org

# Deixe vazio até o frontend Render existir; depois use a URL exata dele.
# Exemplo: https://rsi-radar.onrender.com
CORS_ALLOWED_ORIGINS=

# Telegram: preencha somente na VM com os valores reais, nunca no GitHub.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_MAX_DISPATCH_PER_CYCLE=10
# O alerta inclui RSI dos demais períodos; o período disparador não se repete.
TELEGRAM_ALLOWED_INTERVALS=
TELEGRAM_SIGNAL_LEVELS=
TELEGRAM_MAX_RANK=

# Opcional: limite a coleta a pares/timeframes específicos em uma VM pequena.
# Deixe vazio na Oracle A1 para acompanhar todos os pares USDT.
RSI_WORKER_INTERVALS=
RSI_WORKER_SYMBOLS=
