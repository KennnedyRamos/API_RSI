# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/api_rsi

# API
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
APP_TIMEZONE=America/Sao_Paulo

# Origens do frontend autorizado a consultar a API, separadas por vírgula.
# Exemplo futuro: https://seu-painel.onrender.com
CORS_ALLOWED_ORIGINS=

# Telegram. Deixe TELEGRAM_ENABLED=false enquanto o bot não estiver pronto.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional: tópico de um supergrupo do Telegram.
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_MAX_DISPATCH_PER_CYCLE=10
# A mensagem também mostra o RSI atual dos demais períodos suportados.
# O período que disparou o alerta não é repetido.

# Filtros opcionais do grupo. Vazios significam "sem filtro".
# Intervalos aceitos: 5m,15m,30m,1h,4h,12h,1d,1w,1M.
# Níveis usam códigos internos: NORMAL,MODERATE,STRONG,EXTREME.
# As mensagens exibem esses níveis em português brasileiro.
TELEGRAM_ALLOWED_INTERVALS=
TELEGRAM_SIGNAL_LEVELS=
TELEGRAM_MAX_RANK=

# URL pública opcional para incluir um link de análise na mensagem.
DASHBOARD_PUBLIC_URL=
